{
  "name": "@reyhanfahlevi/mikrotik-mcp",
  "version": "0.1.0",
  "description": "MikroTik RouterOS v7 Model Context Protocol (MCP) Server",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mikrotik-mcp": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mikrotik",
    "routeros",
    "routeros-v7",
    "network",
    "networking",
    "monitoring",
    "observability"
  ],
  "author": "Reyhan Fahlevi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reyhanfahlevi/mikrotik-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/reyhanfahlevi/mikrotik-mcp/issues"
  },
  "homepage": "https://github.com/reyhanfahlevi/mikrotik-mcp#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
